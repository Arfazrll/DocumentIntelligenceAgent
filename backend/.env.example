# LLM APIs (Optional Cloud Fallback Keys)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Models (Local AI Engine)
USE_LOCAL_LLM=true
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_VERIFIER_MODEL=qwen2.5:0.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b

# Database & Vector Store
DATABASE_URL=sqlite+aiosqlite:///./data/docintel.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents

# System Config
MAX_UPLOAD_SIZE_MB=100
MAX_FILES_PER_UPLOAD=10
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K_INITIAL=20
RETRIEVAL_TOP_K_FINAL=5
CONFIDENCE_THRESHOLD=0.70
